# Copie para .env e preencha com valores reais.
# Na Vercel, a integração do Supabase já injeta POSTGRES_PRISMA_URL e
# POSTGRES_URL_NON_POOLING automaticamente — só falta adicionar AUTH_SECRET.

# Conexão via pooler (PgBouncer) — usada em runtime pela aplicação.
POSTGRES_PRISMA_URL="postgres://usuario:senha@host:6543/postgres?sslmode=require&pgbouncer=true"

# Conexão direta — usada só pelo Prisma Migrate (o pooler não suporta as
# operações que uma migração precisa rodar).
POSTGRES_URL_NON_POOLING="postgres://usuario:senha@host:5432/postgres?sslmode=require"

# Gere um valor novo para produção com: openssl rand -base64 32
AUTH_SECRET="troque-este-valor-em-producao-com-openssl-rand-base64-32"
